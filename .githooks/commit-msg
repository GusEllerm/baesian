#!/bin/sh
# >>> baesian >>>
# Baesian's commit gate (D54). Managed by `baesian init`: edit outside the markers.
if command -v baesian >/dev/null 2>&1; then
  baesian hook commit-msg "$1" || exit $?
elif baesian_fallback="$(git config --get baesian.fallback)" && [ -n "$baesian_fallback" ]; then
  eval "$baesian_fallback hook commit-msg \"\$1\"" || exit $?
else
  echo "baesian: not on PATH; install it (npm i -g baesian) or commit with --no-verify (CI runs the same check)." >&2
  exit 1
fi
# <<< baesian <<<
