{
  "name": "baesian",
  "version": "0.0.0",
  "private": true,
  "description": "Swipe review for agent decisions: agents file decision cards, a human answers them, verdicts flow back through git.",
  "type": "module",
  "bin": {
    "baesian": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "baesian": "tsx src/bin.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
