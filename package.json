{
  "name": "baesian",
  "version": "0.0.0",
  "private": true,
  "description": "Swipe review for agent decisions: agents file decision cards, a human answers them, verdicts flow back through git.",
  "type": "module",
  "bin": {
    "baesian": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config client/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p client --noEmit",
    "test": "vitest run",
    "test:service": "npm --prefix service run typecheck && npm --prefix service test",
    "e2e": "npm run build && playwright test",
    "dev:client": "vite --config client/vite.config.ts",
    "demo": "vite build --config client/vite.config.ts --logLevel warn && tsx scripts/demo.ts",
    "readme-media": "vite build --config client/vite.config.ts --logLevel warn && tsx scripts/readme-media.ts",
    "baesian": "tsx src/bin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "commander": "^15.0.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/alegreya": "5.3.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
