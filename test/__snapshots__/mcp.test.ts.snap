      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "File the next revision of a card the reviewer returned, as \`baesian revise\` does: your reply to their answer, as the card's fields in full. Returns the new revision.",
    "name": "revise_card",
    "title": "Revise a returned card",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "When the reviewer's answer went against your pick and you hold a fact they lacked, or a check that would settle it, reply once, as \`baesian reply\` does. Not your pick again. Until they answer again, proceed with their decision.",
    "name": "reply_to_card",
    "title": "Reply once to an answer",
