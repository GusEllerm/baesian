{
  "name": "baesian-relay",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "description": "Baesian's hosted service: the relay (M9b), a Cloudflare Worker with one Durable Object per project running Baesian's own store over each project's files, and accounts and sign-in (M9c) in one D1 database.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "dev-vars": "node scripts/dev-vars.mjs",
    "migrate:local": "wrangler d1 migrations apply baesian-accounts --local",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false > /dev/null && tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.store.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "oauth4webapi": "3.8.8"
  }
}
