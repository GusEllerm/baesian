{
  // The relay's types: the runtime's and the Worker's bindings come from `wrangler types` (worker-configuration.d.ts,
  // generated, not committed), the tests' from the Vitest plugin. It imports the store from ../src as it is.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "vitest.config.ts", "vitest.store.config.ts"]
}
